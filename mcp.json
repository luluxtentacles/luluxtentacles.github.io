{
  "mcpServers": {
    "playwright": {
      "command": "node/node.exe",
      "args": [
        "node/node_modules/npm/bin/npx-cli.js",
        "-y",
        "@playwright/mcp",
        "--browser",
        "chromium",
        "--user-data-dir",
        "browser-profile",
        "--proxy-server",
        "http://127.0.0.1:38123"
      ],
      
      "env": {
        "npm_config_cache": "node_cache"
      }
    }
  }
}
